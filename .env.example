# --- Database (Postgres) ---
# App runtime uses the POOLED connection. On Neon this is the "-pooler" host.
DATABASE_URL="postgresql://user:password@localhost:5432/wassup?schema=public"
# Migrations use the DIRECT (unpooled) connection. Locally you can point this at
# the same string as DATABASE_URL; on Neon use the non-pooler host.
DIRECT_URL="postgresql://user:password@localhost:5432/wassup?schema=public"

# --- Auth ---
ANTHROPIC_API_KEY="your-anthropic-api-key"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Password reset emails (optional) ---
# Without RESEND_API_KEY the reset link is logged to the server console instead
# of emailed.
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="DailyDose <no-reply@dailydose.com>"

# Base URL used to build reset links in emails. On Vercel this falls back to the
# deployment URL automatically, so you only need to set it for a custom domain
# or local dev.
APP_URL="http://localhost:3000"
