DATABASE_URL="postgresql://user:password@localhost:5432/wassup?schema=public"
ANTHROPIC_API_KEY="your-anthropic-api-key"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Password reset emails (optional — without RESEND_API_KEY the reset link is
# logged to the server console instead of emailed).
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM="DailyDose <no-reply@dailydose.com>"
# Base URL used to build reset links in emails.
APP_URL="http://localhost:3000"
